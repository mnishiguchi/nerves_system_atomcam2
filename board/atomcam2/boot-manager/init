#!/bin/sh
set -eu

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

boot_mount=""
final_boot_mount="/media/mmc"
application_mount="/mnt/application"
old_root_mount="/mnt/boot-manager"
old_root_relative_mount="mnt/boot-manager"
report_name="atomcam2-boot-manager.env"
boot_mount_writable=0
prototype_data_partition=""
metadata_command="/usr/bin/atomcam2-boot-metadata"
metadata_work_dir="/tmp/atomcam2-boot-metadata"
metadata_output_path="$metadata_work_dir/selected.env"
metadata_error_path="$metadata_work_dir/select.err"
boot_metadata_status="not_read"
boot_metadata_error=""
boot_metadata_selected_copy=""
boot_metadata_magic=""
boot_metadata_generation=""
boot_metadata_confirmed_slot=""
boot_metadata_pending_slot=""
boot_metadata_pending_attempts=""
boot_metadata_max_attempts=""
boot_metadata_slot_a_status=""
boot_metadata_slot_a_firmware_id=""
boot_metadata_slot_a_sha256=""
boot_metadata_slot_b_status=""
boot_metadata_slot_b_firmware_id=""
boot_metadata_slot_b_sha256=""
boot_metadata_checksum_sha256=""

boot_policy_status="not_read"
boot_policy_error=""
boot_policy_selected_slot=""
boot_policy_selection_reason=""

bootstrap_kernel_filesystems() {
  mkdir -p /dev /proc /sys /tmp "$final_boot_mount" "$application_mount"

  if [ ! -r /proc/mounts ]; then
    if mount -t proc proc /proc 2>/dev/null; then
      :
    else
      true
    fi
  fi

  if [ ! -d /sys/class/block ]; then
    if mount -t sysfs sysfs /sys 2>/dev/null; then
      :
    else
      true
    fi
  fi

  if [ ! -b /dev/mmcblk0 ]; then
    if [ ! -b /dev/mmcblk1 ]; then
      if mount -t devtmpfs devtmpfs /dev 2>/dev/null; then
        :
      else
        true
      fi
    fi
  fi
  if ! is_mounted /tmp; then
    if mount -t tmpfs tmpfs /tmp 2>/dev/null; then
      :
    else
      true
    fi
  fi
}

find_prototype_data_partition() {
  for candidate_partition in /dev/mmcblk*p3; do
    if [ -b "$candidate_partition" ]; then
      prototype_data_partition="$candidate_partition"
      return 0
    fi
  done

  return 1
}

write_raw_stage() {
  raw_stage="$1"

  if [ -z "$prototype_data_partition" ]; then
    if ! find_prototype_data_partition; then
      return 0
    fi
  fi

  raw_stage_partition="$prototype_data_partition"

  if [ ! -b "$raw_stage_partition" ]; then
    moved_raw_stage_partition="$application_mount$prototype_data_partition"

    if [ -b "$moved_raw_stage_partition" ]; then
      raw_stage_partition="$moved_raw_stage_partition"
    else
      return 0
    fi
  fi

  if printf 'ATOMCAM2_BOOT_STAGE=%s\n' "$raw_stage" |
    dd \
      of="$raw_stage_partition" \
      bs=256 \
      count=1 \
      conv=sync,notrunc \
      2>&9; then
    :
  else
    true
  fi

  if sync 2>&9; then
    :
  else
    true
  fi
}

boot_bind_moved=0
boot_mount_moved=0
dev_moved=0
proc_moved=0
sys_moved=0

is_mounted() {
  mount_point="$1"

  awk -v mount_point="$mount_point" '
    $2 == mount_point {
      found = 1
      exit
    }

    END {
      exit(found ? 0 : 1)
    }
  ' /proc/mounts
}

read_boot_policy() {
  boot_policy_status="unavailable"
  boot_policy_error=""

  case "$boot_policy_selected_slot" in
    A|B)
      ;;
    *)
      boot_policy_error="selected_slot_invalid"
      return 1
      ;;
  esac

  case "$boot_policy_selection_reason" in
    confirmed|pending|pending_attempt_limit)
      ;;
    *)
      boot_policy_error="selection_reason_invalid"
      return 1
      ;;
  esac

  boot_policy_status="selected"
  return 0
}

read_boot_metadata() {
  boot_metadata_status="unavailable"
  boot_metadata_error=""
  boot_metadata_selected_copy=""
  boot_metadata_magic=""
  boot_metadata_generation=""
  boot_metadata_confirmed_slot=""
  boot_metadata_pending_slot=""
  boot_metadata_pending_attempts=""
  boot_metadata_max_attempts=""
  boot_metadata_slot_a_status=""
  boot_metadata_slot_a_firmware_id=""
  boot_metadata_slot_a_sha256=""
  boot_metadata_slot_b_status=""
  boot_metadata_slot_b_firmware_id=""
  boot_metadata_slot_b_sha256=""
  boot_metadata_checksum_sha256=""
  boot_policy_status="unavailable"
  boot_policy_error=""
  boot_policy_selected_slot=""
  boot_policy_selection_reason=""

  if [ ! -x "$metadata_command" ]; then
    boot_metadata_error="codec_unavailable"
    return 1
  fi

  if rm -rf "$metadata_work_dir"; then
    :
  else
    boot_metadata_error="work_directory_cleanup_failed"
    return 1
  fi

  if mkdir -p "$metadata_work_dir"; then
    :
  else
    boot_metadata_error="work_directory_creation_failed"
    return 1
  fi

  if "$metadata_command" \
    select-device \
    "$root_disk" \
    "$metadata_work_dir" \
    > "$metadata_output_path" \
    2> "$metadata_error_path"
  then
    while IFS= read -r metadata_line; do
      case "$metadata_line" in
        selected_copy=*)
          boot_metadata_selected_copy="${metadata_line#selected_copy=}"
          ;;
        selected_slot=*)
          boot_policy_selected_slot="${metadata_line#selected_slot=}"
          ;;
        selection_reason=*)
          boot_policy_selection_reason="${metadata_line#selection_reason=}"
          ;;
        ATOMCAM2_BOOT_METADATA_V1)
          boot_metadata_magic="$metadata_line"
          ;;
        generation=*)
          boot_metadata_generation="${metadata_line#generation=}"
          ;;
        confirmed_slot=*)
          boot_metadata_confirmed_slot="${metadata_line#confirmed_slot=}"
          ;;
        pending_slot=*)
          boot_metadata_pending_slot="${metadata_line#pending_slot=}"
          ;;
        pending_attempts=*)
          boot_metadata_pending_attempts="${metadata_line#pending_attempts=}"
          ;;
        max_attempts=*)
          boot_metadata_max_attempts="${metadata_line#max_attempts=}"
          ;;
        slot_a_status=*)
          boot_metadata_slot_a_status="${metadata_line#slot_a_status=}"
          ;;
        slot_a_firmware_id=*)
          boot_metadata_slot_a_firmware_id="${metadata_line#slot_a_firmware_id=}"
          ;;
        slot_a_sha256=*)
          boot_metadata_slot_a_sha256="${metadata_line#slot_a_sha256=}"
          ;;
        slot_b_status=*)
          boot_metadata_slot_b_status="${metadata_line#slot_b_status=}"
          ;;
        slot_b_firmware_id=*)
          boot_metadata_slot_b_firmware_id="${metadata_line#slot_b_firmware_id=}"
          ;;
        slot_b_sha256=*)
          boot_metadata_slot_b_sha256="${metadata_line#slot_b_sha256=}"
          ;;
        checksum_sha256=*)
          boot_metadata_checksum_sha256="${metadata_line#checksum_sha256=}"
          ;;
        *)
          boot_metadata_error="unexpected_codec_output"
          return 1
          ;;
      esac
    done < "$metadata_output_path"

    if [ "$boot_metadata_magic" != "ATOMCAM2_BOOT_METADATA_V1" ]; then
      boot_metadata_error="metadata_magic_missing"
      return 1
    fi

    if [ -z "$boot_metadata_selected_copy" ]; then
      boot_metadata_error="selected_copy_missing"
      return 1
    fi

    if [ -z "$boot_metadata_generation" ]; then
      boot_metadata_error="generation_missing"
      return 1
    fi

    if [ -z "$boot_metadata_confirmed_slot" ]; then
      boot_metadata_error="confirmed_slot_missing"
      return 1
    fi

    if [ -z "$boot_metadata_checksum_sha256" ]; then
      boot_metadata_error="checksum_missing"
      return 1
    fi

    boot_metadata_status="selected"
    return 0
  fi

  if [ -s "$metadata_error_path" ]; then
    boot_metadata_error="$(
      sed -n \
        '1s/^atomcam2 boot metadata: //p' \
        "$metadata_error_path"
    )"
  fi

  if [ -z "$boot_metadata_error" ]; then
    boot_metadata_error="selection_failed"
  fi

  return 1
}

write_report_to() {
  output_path="$1"
  stage="$2"
  temporary_output_path="${output_path}.tmp"

  if {
    echo "stage=$stage"
    echo "boot_partition=${boot_partition:-}"
    echo "boot_mount=${boot_mount:-}"
    echo "boot_mount_writable=$boot_mount_writable"
    echo "root_disk=${root_disk:-}"
    echo "application_partition=${application_partition:-}"
    echo "boot_metadata_status=$boot_metadata_status"
    echo "boot_metadata_error=$boot_metadata_error"
    echo "boot_metadata_selected_copy=$boot_metadata_selected_copy"
    echo "boot_metadata_generation=$boot_metadata_generation"
    echo "boot_metadata_confirmed_slot=$boot_metadata_confirmed_slot"
    echo "boot_metadata_pending_slot=$boot_metadata_pending_slot"
    echo "boot_metadata_pending_attempts=$boot_metadata_pending_attempts"
    echo "boot_metadata_max_attempts=$boot_metadata_max_attempts"
    echo "boot_metadata_slot_a_status=$boot_metadata_slot_a_status"
    echo "boot_metadata_slot_a_firmware_id=$boot_metadata_slot_a_firmware_id"
    echo "boot_metadata_slot_a_sha256=$boot_metadata_slot_a_sha256"
    echo "boot_metadata_slot_b_status=$boot_metadata_slot_b_status"
    echo "boot_metadata_slot_b_firmware_id=$boot_metadata_slot_b_firmware_id"
    echo "boot_metadata_slot_b_sha256=$boot_metadata_slot_b_sha256"
    echo "boot_metadata_checksum_sha256=$boot_metadata_checksum_sha256"
    echo "boot_policy_status=$boot_policy_status"
    echo "boot_policy_error=$boot_policy_error"
    echo "boot_policy_selected_slot=$boot_policy_selected_slot"
    echo "boot_policy_selection_reason=$boot_policy_selection_reason"
  } > "$temporary_output_path" 2>&9; then
    if mv -f "$temporary_output_path" "$output_path" 2>&9; then
      return 0
    fi
  fi

  if [ -e "$temporary_output_path" ]; then
    if rm -f "$temporary_output_path" 2>&9; then
      :
    else
      true
    fi
  fi

  return 1
}

write_report() {
  stage="$1"

  write_raw_stage "$stage"

  if [ "$boot_mount_moved" -eq 1 ]; then
    moved_report_path="$application_mount$final_boot_mount/$report_name"

    if write_report_to "$moved_report_path" "$stage"; then
      return 0
    fi
  fi

  if [ -n "${boot_mount:-}" ]; then
    if write_report_to "$boot_mount/$report_name" "$stage"; then
      return 0
    fi
  fi

  if write_report_to "$application_mount$final_boot_mount/$report_name" "$stage"; then
    return 0
  fi

  if write_report_to "$final_boot_mount/$report_name" "$stage"; then
    return 0
  fi

  if write_report_to "/tmp/$report_name" "$stage"; then
    return 0
  fi

  return 0
}

restore_mounts() {
  if [ "$proc_moved" -eq 1 ]; then
    if mount --move "$application_mount/proc" /proc; then
      proc_moved=0
    fi
  fi

  if [ "$boot_mount_moved" -eq 1 ]; then
    if mount --move "$application_mount$final_boot_mount" "$boot_mount"; then
      boot_mount_moved=0
    fi
  fi

  if [ "$sys_moved" -eq 1 ]; then
    if mount --move "$application_mount/sys" /sys; then
      sys_moved=0
    fi
  fi

  if [ "$dev_moved" -eq 1 ]; then
    if mount --move "$application_mount/dev" /dev; then
      dev_moved=0
    fi
  fi

  if [ "$boot_bind_moved" -eq 1 ]; then
    if mount --move "$application_mount/boot" /boot; then
      boot_bind_moved=0
    fi
  fi
}

enter_recovery() {
  stage="$1"

  write_report "$stage"
  restore_mounts
  write_report "${stage}_recovered"
  echo "atomcam2 boot manager: $stage" >&2
  exec 9>&-
  exec sh
}

find_boot_mount() {
  while read -r source_mount mount_point filesystem_type mount_options dump pass; do
    if [ -f "$mount_point/rootfs_hack.squashfs" ]; then
      if [ -f "$mount_point/factory_t31_ZMC6tiIDQN" ]; then
        boot_partition="$source_mount"
        boot_mount="$mount_point"
        return 0
      fi
    fi
  done < /proc/mounts

  return 1
}

ensure_boot_mount_writable() {
  write_probe="$boot_mount/.atomcam2-boot-manager-write-test"

  if : > "$write_probe" 2>&9; then
    rm -f "$write_probe"
    return 0
  fi

  if mount -o remount,rw "$boot_partition" "$boot_mount" 2>&9; then
    if : > "$write_probe" 2>&9; then
      rm -f "$write_probe"
      return 0
    fi
  fi

  return 1
}

derive_root_disk() {
  case "$boot_partition" in
    /dev/mmcblk[0-9]p[0-9]*)
      root_disk="${boot_partition%p[0-9]*}"
      ;;
    *)
      return 1
      ;;
  esac

  if [ ! -b "$root_disk" ]; then
    return 1
  fi

  return 0
}

mkdir -p "$application_mount" /tmp

bootstrap_kernel_filesystems
exec 9>/dev/null
write_raw_stage "boot_manager_entered"

boot_partition=""
if ! find_boot_mount; then
  enter_recovery "boot_mount_not_found"
fi

if ensure_boot_mount_writable; then
  boot_mount_writable=1
fi

write_report "boot_manager_entered"

root_disk=""
if ! derive_root_disk; then
  enter_recovery "root_disk_not_found"
fi

if read_boot_metadata; then
  write_report "boot_metadata_selected"

  if read_boot_policy; then
    write_report "boot_policy_selected"
  else
    write_report "boot_policy_unavailable"
  fi
else
  boot_policy_status="unavailable"
  boot_policy_error="metadata_unavailable"
  write_report "boot_metadata_unavailable"
fi

application_partition="${root_disk}p2"
if [ ! -b "$application_partition" ]; then
  enter_recovery "application_partition_not_found"
fi

pivot_root_command="/sbin/pivot_root"

if [ ! -x "$pivot_root_command" ]; then
  enter_recovery "pivot_root_unavailable"
fi

if ! mount -t squashfs -o ro "$application_partition" "$application_mount"; then
  enter_recovery "application_mount_failed"
fi

if [ ! -x "$application_mount/sbin/init" ]; then
  enter_recovery "application_init_missing"
fi

application_umount_command=""

for candidate_command in /bin/umount /sbin/umount; do
  if [ -x "$application_mount$candidate_command" ]; then
    application_umount_command="$candidate_command"
    break
  fi
done

if [ -z "$application_umount_command" ]; then
  enter_recovery "application_umount_missing"
fi

for required_directory in boot dev media/mmc mnt/boot-manager proc sys; do
  if [ ! -d "$application_mount/$required_directory" ]; then
    enter_recovery "application_mountpoint_missing"
  fi
done

write_report "application_mounted"

if is_mounted /boot; then
  write_report "boot_bind_move"

  if mount --move /boot "$application_mount/boot"; then
    boot_bind_moved=1
    write_report "boot_bind_moved"
  else
    enter_recovery "boot_bind_move_failed"
  fi
else
  write_report "boot_bind_not_mounted"
fi

write_report "dev_move"

if mount --move /dev "$application_mount/dev"; then
  dev_moved=1
  write_report "dev_moved"
else
  enter_recovery "dev_move_failed"
fi

write_report "sys_move"

if mount --move /sys "$application_mount/sys"; then
  sys_moved=1
  write_report "sys_moved"
else
  enter_recovery "sys_move_failed"
fi

write_report "boot_mount_move"

if mount --move "$boot_mount" "$application_mount$final_boot_mount"; then
  boot_mount_moved=1
  write_report "boot_mount_moved"
else
  enter_recovery "boot_mount_move_failed"
fi

write_report "proc_move"

if mount --move /proc "$application_mount/proc"; then
  proc_moved=1
  write_report "proc_moved"
else
  enter_recovery "proc_move_failed"
fi

write_report "pivot_root"

pivot_root_error_path="$application_mount$final_boot_mount/atomcam2-pivot-root.err"

cd "$application_mount"
if "$pivot_root_command" . "$old_root_relative_mount" 2>"$pivot_root_error_path"; then
  cd /
  write_raw_stage "pivot_root_returned"
else
  pivot_root_status="$?"
  cd /
  write_report "pivot_root_failed_${pivot_root_status}"
  restore_mounts
  write_report "pivot_root_recovered_${pivot_root_status}"
  echo "atomcam2 boot manager: pivot_root failed with status $pivot_root_status" >&2
  exec 9>&-
  exec sh
fi

write_raw_stage "old_root_unmount"

old_root_unmount_error_path="$final_boot_mount/atomcam2-old-root-unmount.err"

if "$application_umount_command"   -l   "$old_root_mount"   2>"$old_root_unmount_error_path"; then

  write_raw_stage "old_root_unmounted"
else
  old_root_unmount_status="$?"
  write_report "old_root_unmount_failed_${old_root_unmount_status}"
  echo     "atomcam2 boot manager: old root unmount failed with status $old_root_unmount_status"     >&2
  exec 9>&-
  exec sh
fi

boot_mount="$final_boot_mount"
boot_bind_moved=0
boot_mount_moved=0
dev_moved=0
proc_moved=0
sys_moved=0

write_report "application_root"
exec 9>&-
exec /sbin/init
