# Minimal AtomCam2 first-SSH runtime defaults.

export ATOMCAM2_BOOT_MOUNT="${ATOMCAM2_BOOT_MOUNT:-/media/mmc}"
export ATOMCAM2_HOSTNAME_FILE="${ATOMCAM2_HOSTNAME_FILE:-/media/mmc/hostname}"
export ATOMCAM2_PRE_RUN_REPORT="${ATOMCAM2_PRE_RUN_REPORT:-/media/mmc/atomcam2-pre-run.env}"
export ATOMCAM2_NETWORK_REPORT="${ATOMCAM2_NETWORK_REPORT:-/media/mmc/atomcam2-network.env}"
export ATOMCAM2_WIFI_DRIVER_REPORT="${ATOMCAM2_WIFI_DRIVER_REPORT:-/media/mmc/atomcam2-wifi-driver.env}"
export ATOMCAM2_WIFI_MODULE_CANDIDATES="${ATOMCAM2_WIFI_MODULE_CANDIDATES:-/media/mmc/modules/8189fs.ko /system/driver/8189fs.ko /driver/8189fs.ko /lib/modules/8189fs.ko}"
export ATOMCAM2_PRE_RUN_WIFI_DRIVER="${ATOMCAM2_PRE_RUN_WIFI_DRIVER:-1}"
export ATOMCAM2_DEFAULT_HOSTNAME="${ATOMCAM2_DEFAULT_HOSTNAME:-nerves}"
