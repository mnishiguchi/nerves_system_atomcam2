#!/bin/sh
# Play the boot announcement through the speaker. Assumes native-only
# operation (no iCamera_app, which would otherwise hold the IMPAudio
# lock). The audio kernel modules are normally loaded by CameraNative in
# the vendor's order (tx_isp before audio — loading audio first leaves
# the codec broken), so this script waits for the audio devices and only
# falls back to loading the modules itself when nothing else does.
# Requires /atom/system mounted (done by atomcam2-wifi-driver in
# pre-run). The status LEDs are driven by the application
# (Atomcam2NervesApp.StatusLed), not here.
set -u

PATH="/usr/sbin:/usr/bin:/sbin:/bin"
export PATH

if [ -f /etc/atomcam2.env ]; then
  . /etc/atomcam2.env
fi

if [ -f /media/mmc/atomcam2.env ]; then
  . /media/mmc/atomcam2.env
fi

enabled="${ATOMCAM2_BOOT_ANNOUNCE:-enabled}"
sound_file="${ATOMCAM2_BOOT_ANNOUNCE_SOUND:-/usr/share/atomcam2/boot-announce.raw}"
player="${ATOMCAM2_BOOT_ANNOUNCE_PLAYER:-/usr/bin/atomcam2-aoplay}"
gain="${ATOMCAM2_BOOT_ANNOUNCE_GAIN:-1}"
rate="${ATOMCAM2_BOOT_ANNOUNCE_RATE:-8000}"
volume="${ATOMCAM2_BOOT_ANNOUNCE_VOLUME:-60}"
vendor_root="${ATOMCAM2_VENDOR_ROOT:-/atom}"
vendor_system="${ATOMCAM2_VENDOR_SYSTEM:-/atom/system}"

[ "$enabled" = "enabled" ] || exit 0

audio_devices_present() {
  [ -c /dev/dsp ] && [ -c /dev/speakerctl ]
}

wait_for_audio_devices() {
  waited=0

  while [ "$waited" -lt "${ATOMCAM2_BOOT_ANNOUNCE_WAIT_S:-20}" ]; do
    if audio_devices_present; then
      return 0
    fi

    sleep 1
    waited=$((waited + 1))
  done

  return 1
}

# Standalone fallback for when the camera auto-start is disabled and
# nothing else loads the modules. tx_isp has to come first: loading
# audio.ko without it leaves the codec broken (IMP_AO_Enable = -1).
load_audio_modules() {
  if ! grep -q "^tx_isp_t31 " /proc/modules 2>/dev/null; then
    /sbin/insmod "$vendor_system/driver/tx-isp-t31.ko" isp_clk=100000000 || true
  fi

  if [ ! -c /dev/dsp ]; then
    /sbin/insmod "$vendor_system/driver/audio.ko" spk_gpio=-1 || true
  fi

  if [ ! -c /dev/speakerctl ]; then
    /sbin/insmod "$vendor_system/driver/speaker_ctl.ko" || true
  fi
}

announce_ready() {
  if [ ! -x "$player" ]; then
    echo "atomcam2-boot-announce: player is missing: $player" >&2
    return 1
  fi

  if [ ! -f "$sound_file" ]; then
    echo "atomcam2-boot-announce: sound file is missing: $sound_file" >&2
    return 1
  fi

  if ! wait_for_audio_devices; then
    load_audio_modules
  fi

  if ! audio_devices_present; then
    echo "atomcam2-boot-announce: audio devices are not ready" >&2
    return 1
  fi

  return 0
}

announce_ready || exit 1

if ! LD_LIBRARY_PATH="$vendor_system/lib:$vendor_root/lib" \
    "$player" "$sound_file" "$gain" "$rate" "$volume" >/dev/null 2>&1; then
  echo "atomcam2-boot-announce: playback failed" >&2
  exit 1
fi

exit 0
