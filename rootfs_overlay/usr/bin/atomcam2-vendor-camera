#!/bin/sh
set -u

vendor_root="${ATOMCAM2_VENDOR_ROOT:-/atom}"
vendor_system="${ATOMCAM2_VENDOR_SYSTEM:-$vendor_root/system}"
vendor_configs="${ATOMCAM2_VENDOR_CONFIGS:-$vendor_root/configs}"
data_mount="${ATOMCAM2_DATA_MOUNT:-/data}"
runtime_root="${ATOMCAM2_VENDOR_RUNTIME_ROOT:-$data_mount/atomcam2-vendor-camera}"
private_configs="$runtime_root/configs"
spool_root="$runtime_root/spool"
logs_root="$runtime_root/logs"
state_root="$runtime_root/state"
mounts_file="$state_root/mounts"
modules_file="$state_root/modules"
runtime_state_file="$state_root/runtime"
boot_id_file="$state_root/boot-id"
ipc_before_prefix="$state_root/ipc-before"
lock_dir="${ATOMCAM2_VENDOR_LOCK_DIR:-/tmp/atomcam2-vendor-camera.lock}"
blocked_command="${ATOMCAM2_VENDOR_BLOCKED_COMMAND:-/usr/libexec/atomcam2-vendor-camera-blocked-command}"
nerves_owned_command="${ATOMCAM2_VENDOR_NERVES_OWNED_COMMAND:-/usr/libexec/atomcam2-vendor-camera-nerves-owned-command}"
compat_shim="${ATOMCAM2_VENDOR_COMPAT_SHIM:-/usr/lib/atomcam2-vendor-camera/libcompat-shim.so}"
chroot_command="${ATOMCAM2_VENDOR_CHROOT:-/usr/sbin/chroot}"
setpriv_command="${ATOMCAM2_VENDOR_SETPRIV:-/usr/bin/setpriv}"
sensor_data_interface="${ATOMCAM2_VENDOR_SENSOR_DATA_INTERFACE:-1}"

failures=0
gates=0
warnings=0
cleanup_failures=0

pass() {
  echo "PASS $*"
}

info() {
  echo "INFO $*"
}

warn() {
  warnings=$((warnings + 1))
  echo "WARN $*"
}

block() {
  failures=$((failures + 1))
  echo "BLOCK $*"
}

gate() {
  gates=$((gates + 1))
  echo "GATE $*"
}

usage() {
  cat <<'EOF_USAGE'
Usage:
  atomcam2-vendor-camera precheck
  atomcam2-vendor-camera prepare
  atomcam2-vendor-camera start
  atomcam2-vendor-camera status
  atomcam2-vendor-camera stop

precheck performs read-only inspection. prepare creates the private
configuration and spool below /data. start and stop operate only the manual
compatibility runtime; automatic boot, NAS export, and retention are not
enabled.
EOF_USAGE
}

mount_field() {
  mount_point="$1"
  field_number="$2"

  awk \
    -v mount_point="$mount_point" \
    -v field_number="$field_number" \
    '$2 == mount_point { value = $field_number }
     END { print value }' \
    /proc/mounts
}

require_read_only_mount() {
  required_mount="$1"
  required_source="$2"
  required_type="$3"
  mount_source="$(mount_field "$required_mount" 1)"
  mount_type="$(mount_field "$required_mount" 3)"
  mount_options="$(mount_field "$required_mount" 4)"

  if [ -z "$mount_source" ]; then
    block "$required_mount is not mounted"
    return
  fi

  if [ -n "$required_source" ] && [ "$mount_source" != "$required_source" ]; then
    block "$required_mount source is $mount_source, expected $required_source"
  elif [ "$mount_type" != "$required_type" ]; then
    block "$required_mount type is $mount_type, expected $required_type"
  else
    case ",$mount_options," in
      *,ro,*)
        pass "$required_mount is $mount_type read-only from $mount_source"
        ;;
      *)
        block "$required_mount is not read-only"
        ;;
    esac
  fi
}

require_read_write_mount() {
  required_mount="$1"
  mount_source="$(mount_field "$required_mount" 1)"
  mount_type="$(mount_field "$required_mount" 3)"
  mount_options="$(mount_field "$required_mount" 4)"

  if [ -z "$mount_source" ]; then
    block "$required_mount is not mounted"
    return
  fi

  case ",$mount_options," in
    *,rw,*)
      case ",$mount_options," in
        *,noexec,*)
          block "$required_mount is read-write but does not permit executables"
          ;;
        *)
          pass "$required_mount is $mount_type read-write and executable from $mount_source"
          ;;
      esac
      ;;
    *)
      block "$required_mount is not read-write"
      ;;
  esac
}

process_running() {
  expected_name="$1"

  for process_status in /proc/[0-9]*/status; do
    candidate_process_name="$(
      awk '$1 == "Name:" { print $2; exit }' "$process_status" 2>/dev/null
    )"

    if [ "$candidate_process_name" = "$expected_name" ]; then
      return 0
    fi
  done

  return 1
}

require_file() {
  required_file="$1"

  if [ -r "$required_file" ]; then
    pass "readable $required_file"
  else
    block "missing or unreadable $required_file"
  fi
}

require_executable() {
  required_executable="$1"

  if [ -x "$required_executable" ]; then
    pass "executable $required_executable"
  else
    block "missing or non-executable $required_executable"
  fi
}

require_module_abi() {
  module_file="$1"
  kernel_release="$2"

  if [ ! -r "$module_file" ]; then
    block "missing camera module $module_file"
    return
  fi

  module_vermagic="$(
    /sbin/modinfo "$module_file" 2>/dev/null |
      awk '$1 == "vermagic:" { print $2; exit }'
  )"

  if [ "$module_vermagic" = "$kernel_release" ]; then
    pass "module ABI matches $kernel_release: $module_file"
  else
    block "module ABI mismatch for $module_file: ${module_vermagic:-unknown}"
  fi
}

find_watchdog_owner() {
  for descriptor in /proc/[0-9]*/fd/*; do
    descriptor_target="$(readlink "$descriptor" 2>/dev/null || true)"

    case "$descriptor_target" in
      /dev/watchdog|/dev/watchdog0)
        owner_pid="${descriptor#/proc/}"
        owner_pid="${owner_pid%%/*}"
        owner_name="$(cat "/proc/$owner_pid/comm" 2>/dev/null || true)"
        echo "$owner_pid:${owner_name:-unknown}:$descriptor_target"
        return
        ;;
      *)
        ;;
    esac
  done
}

precheck() {
  echo "atomcam2 vendor camera feasibility precheck"
  echo "mode=read-only"

  require_read_only_mount "$vendor_root" "" "squashfs"
  require_read_only_mount "$vendor_system" "/dev/mtdblock3" "squashfs"
  require_read_only_mount "$vendor_configs" "/dev/mtdblock6" "jffs2"
  require_read_write_mount "$data_mount"

  if awk '
    $1 ~ /^\/dev\/mtd(block)?[0-9]+$/ && $4 ~ /(^|,)rw(,|$)/ {
      found = 1
    }
    END {
      exit(found ? 0 : 1)
    }
  ' /proc/mounts; then
    block "an internal MTD partition is mounted read-write"
  else
    pass "all mounted internal MTD partitions are read-only"
  fi

  for config_file in \
    "$vendor_configs/.product_config" \
    "$vendor_configs/.user_config" \
    "$vendor_configs/app.ver"; do
    require_file "$config_file"
  done

  for executable in \
    "$vendor_system/bin/ver-comp" \
    "$vendor_system/bin/assis" \
    "$vendor_system/bin/hl_client" \
    "$vendor_system/bin/iCamera_app"; do
    require_executable "$executable"
  done

  for library in \
    "$vendor_root/lib/ld-uClibc.so.0" \
    "$vendor_system/lib/libimp.so" \
    "$vendor_system/lib/liblocalsdk.so" \
    "$vendor_system/lib/liblocalsdk_watchdog.so" \
    "$vendor_system/lib/libmp4rw.so" \
    "$vendor_root/thirdlib/libcrypto.so.1.1" \
    "$vendor_root/thirdlib/libssl.so.1.1"; do
    require_file "$library"
  done

  require_file "$vendor_system/etc/sensor/gc2053-t31.bin"

  kernel_release="$(cat /proc/sys/kernel/osrelease 2>/dev/null || true)"

  if [ -z "$kernel_release" ]; then
    block "kernel release is unavailable"
  else
    info "kernel_release=$kernel_release"

    for module_file in \
      "$vendor_system/driver/tx-isp-t31.ko" \
      "$vendor_system/driver/sensor_gc2053_t31.ko" \
      "$vendor_system/driver/audio.ko" \
      "$vendor_system/driver/avpu.ko" \
      "$vendor_system/driver/sinfo.ko" \
      "$vendor_system/driver/sample_pwm_core.ko" \
      "$vendor_system/driver/sample_pwm_hal.ko" \
      "$vendor_system/driver/speaker_ctl.ko"; do
      require_module_abi "$module_file" "$kernel_release"
    done
  fi

  if grep -q '^atbm603x_wifi_sdio ' /proc/modules &&
      [ -d /sys/class/net/wlan0 ]; then
    pass "Nerves owns the active wlan0 interface"
  else
    block "the Nerves Wi-Fi interface is not healthy"
  fi

  if [ -x /usr/sbin/chroot ] ||
      /bin/busybox --list 2>/dev/null | grep -qx chroot; then
    pass "chroot support is available"
  else
    block "chroot support is unavailable"
  fi

  if [ -r /proc/sysvipc/msg ] && [ -r /proc/sysvipc/shm ]; then
    pass "System V IPC is available"
  else
    block "System V IPC is unavailable"
  fi

  mem_total_kb="$(
    awk '$1 == "MemTotal:" { print $2; exit }' /proc/meminfo
  )"
  reclaimable_kb="$(
    awk '
      $1 == "MemFree:" || $1 == "Buffers:" || $1 == "Cached:" {
        total += $2
      }
      END {
        print total + 0
      }
    ' /proc/meminfo
  )"

  info "memory_total_kb=${mem_total_kb:-0}"
  info "memory_reclaimable_kb=${reclaimable_kb:-0}"

  if [ "${mem_total_kb:-0}" -lt 81920 ]; then
    block "less than 80 MiB of Linux memory is available"
  elif [ "${reclaimable_kb:-0}" -lt 32768 ]; then
    warn "less than 32 MiB is currently free or reclaimable"
  else
    pass "baseline memory headroom is sufficient for a bounded manual trial"
  fi

  if grep -q 'rmem=36M' /proc/cmdline; then
    pass "the camera-reserved 36 MiB memory region is present"
  else
    block "the expected camera-reserved memory region is missing"
  fi

  data_available_kb="$(
    df -k "$data_mount" 2>/dev/null |
      awk 'NR == 2 { print $4; exit }'
  )"
  info "data_available_kb=${data_available_kb:-unknown}"

  if [ "${data_available_kb:-0}" -lt 524288 ]; then
    warn "less than 512 MiB is available for a local recording spool"
  else
    pass "at least 512 MiB is available for a bounded local spool"
  fi

  watchdog_owner="$(find_watchdog_owner)"

  case "$watchdog_owner" in
    *:heart:/dev/watchdog|*:heart:/dev/watchdog0)
      pass "Nerves heart owns the hardware watchdog: $watchdog_owner"
      if [ -r "$compat_shim" ]; then
        pass "vendor assis watchdog calls can be isolated by the compatibility shim"
      else
        gate "the vendor assis watchdog compatibility shim is unavailable"
      fi
      ;;
    "")
      warn "no hardware-watchdog owner was found"
      gate "Nerves watchdog ownership must be healthy before camera startup"
      ;;
    *)
      block "unexpected hardware-watchdog owner: $watchdog_owner"
      ;;
  esac

  for expected_vendor_process in iCamera_app assis hl_client; do
    if process_running "$expected_vendor_process"; then
      block "vendor process is already running during precheck: $expected_vendor_process"
    else
      pass "vendor process is stopped: $expected_vendor_process"
    fi
  done

  if [ -r "$private_configs/.atomcam2-vendor-camera-schema" ]; then
    pass "private writable vendor configuration is prepared at $private_configs"
  elif [ -d "$private_configs" ]; then
    block "the private vendor configuration is incomplete at $private_configs"
  else
    gate "prepare a private writable configuration copy under $runtime_root"
  fi

  if grep -Eq '(^|[[:space:]])nfs([[:space:]]|$)' /proc/filesystems; then
    pass "kernel NFS client support is active"
  else
    warn "the protected v0.2.0 kernel does not expose NFS client support"
  fi

  if grep -Eq '(^|[[:space:]])cifs([[:space:]]|$)' /proc/filesystems; then
    pass "kernel CIFS client support is active"
  else
    info "kernel CIFS client support is not active"
  fi

  pass "physical memory, mobile-app, and local-recording acceptance is complete"

  echo "summary failures=$failures gates=$gates warnings=$warnings"

  if [ "$failures" -gt 0 ]; then
    echo "result=blocked"
    return 1
  fi

  if [ "$gates" -gt 0 ]; then
    echo "result=feasible_with_unresolved_safety_gates"
    return 2
  fi

  echo "result=ready_for_manual_camera_start"
}

current_boot_id() {
  cat /proc/sys/kernel/random/boot_id 2>/dev/null || true
}

require_root() {
  if [ "$(id -u)" = "0" ]; then
    return 0
  fi

  echo "atomcam2-vendor-camera: this command must run as root" >&2
  return 1
}

acquire_lock() {
  if mkdir "$lock_dir" 2>/dev/null; then
    printf '%s\n' "$$" >"$lock_dir/pid"
    trap 'rm -f "$lock_dir/pid"; rmdir "$lock_dir" 2>/dev/null || true' 0 1 2 15
    return 0
  fi

  lock_pid="$(cat "$lock_dir/pid" 2>/dev/null || true)"

  if [ -n "$lock_pid" ] &&
      [ -d "/proc/$lock_pid" ]; then
    echo "atomcam2-vendor-camera: another command is running as PID $lock_pid" >&2
    return 1
  fi

  rm -f "$lock_dir/pid"
  rmdir "$lock_dir" 2>/dev/null || true

  if mkdir "$lock_dir" 2>/dev/null; then
    printf '%s\n' "$$" >"$lock_dir/pid"
    trap 'rm -f "$lock_dir/pid"; rmdir "$lock_dir" 2>/dev/null || true' 0 1 2 15
    return 0
  fi

  echo "atomcam2-vendor-camera: could not acquire the command lock" >&2
  return 1
}

write_runtime_state() {
  runtime_state="$1"
  mkdir -p "$state_root"
  printf '%s\n' "$runtime_state" >"$runtime_state_file"
}

read_runtime_state() {
  cat "$runtime_state_file" 2>/dev/null || echo "not-prepared"
}

clear_stale_runtime_state() {
  previous_boot_id="$(cat "$boot_id_file" 2>/dev/null || true)"

  if [ -n "$previous_boot_id" ] &&
      [ "$previous_boot_id" != "$(current_boot_id)" ]; then
    clear_transient_state
    write_runtime_state "prepared"
    pass "cleared runtime state left by an earlier boot"
  fi
}

module_loaded() {
  expected_module="$1"
  awk -v expected_module="$expected_module" '
    $1 == expected_module {
      found = 1
    }
    END {
      exit(found ? 0 : 1)
    }
  ' /proc/modules
}

mount_present() {
  expected_mount="$1"
  awk -v expected_mount="$expected_mount" '
    $2 == expected_mount {
      found = 1
    }
    END {
      exit(found ? 0 : 1)
    }
  ' /proc/mounts
}

record_mount() {
  mounted_target="$1"
  printf '%s\n' "$mounted_target" >>"$mounts_file"
}

mount_and_record() {
  mounted_target="$1"
  shift

  if "$@"; then
    record_mount "$mounted_target"
    return 0
  fi

  echo "atomcam2-vendor-camera: failed to mount $mounted_target" >&2
  return 1
}

prepare_runtime() {
  require_root || return 1
  acquire_lock || return 1
  umask 077

  if process_running iCamera_app ||
      process_running assis ||
      process_running hl_client; then
    echo "atomcam2-vendor-camera: stop vendor processes before prepare" >&2
    return 1
  fi

  require_read_only_mount "$vendor_configs" "/dev/mtdblock6" "jffs2"

  if [ "$failures" -gt 0 ]; then
    echo "atomcam2-vendor-camera: protected configuration source is unsafe" >&2
    return 1
  fi

  mkdir -p \
    "$runtime_root" \
    "$logs_root" \
    "$state_root" \
    "$spool_root/record" \
    "$spool_root/time_lapse" \
    "$spool_root/log"
  chmod 700 "$runtime_root" "$logs_root" "$state_root" "$spool_root"

  if [ -r "$private_configs/.atomcam2-vendor-camera-schema" ]; then
    pass "private vendor configuration is already prepared"
  elif [ -e "$private_configs" ]; then
    echo "atomcam2-vendor-camera: refusing incomplete configuration at $private_configs" >&2
    return 1
  else
    prepare_target="$runtime_root/configs.prepare.$$"

    if [ -e "$prepare_target" ]; then
      echo "atomcam2-vendor-camera: temporary configuration path already exists" >&2
      return 1
    fi

    mkdir "$prepare_target"

    if ! cp -a "$vendor_configs/." "$prepare_target/"; then
      echo "atomcam2-vendor-camera: private configuration copy failed" >&2
      echo "atomcam2-vendor-camera: incomplete private copy remains at $prepare_target" >&2
      return 1
    fi

    chmod -R go-rwx "$prepare_target"
    printf '%s\n' "1" >"$prepare_target/.atomcam2-vendor-camera-schema"

    if ! mv "$prepare_target" "$private_configs"; then
      echo "atomcam2-vendor-camera: could not publish private configuration" >&2
      echo "atomcam2-vendor-camera: incomplete private copy remains at $prepare_target" >&2
      return 1
    fi

    pass "created private vendor configuration without exposing its contents"
  fi

  case "$(read_runtime_state)" in
    running|starting|stopping|stopped-reboot-required|cleanup-failed)
      ;;
    *)
      write_runtime_state "prepared"
      ;;
  esac
  pass "manual runtime state is prepared below $runtime_root"
}

snapshot_ipc() {
  ipc_kind="$1"
  ipc_source="/proc/sysvipc/$ipc_kind"
  ipc_target="$ipc_before_prefix.$ipc_kind"

  if [ -r "$ipc_source" ]; then
    awk 'NR > 1 { print $2 }' "$ipc_source" >"$ipc_target"
  else
    : >"$ipc_target"
  fi
}

load_camera_module() {
  module_name="$1"
  module_file="$2"
  shift 2

  if module_loaded "$module_name"; then
    echo "atomcam2-vendor-camera: module was already loaded: $module_name" >&2
    return 1
  fi

  if /sbin/insmod "$module_file" "$@"; then
    printf '%s\n' "$module_name" >>"$modules_file"
    pass "loaded camera module $module_name"
    return 0
  fi

  echo "atomcam2-vendor-camera: failed to load $module_name" >&2
  return 1
}

bind_device() {
  device_source="$1"
  device_target="$vendor_root$device_source"

  [ -e "$device_source" ] || return 0

  mkdir -p "${device_target%/*}"
  : >"$device_target"
  mount_and_record "$device_target" \
    /bin/mount --bind "$device_source" "$device_target"
}

setup_device_view() {
  for device_source in \
    /dev/null \
    /dev/zero \
    /dev/full \
    /dev/random \
    /dev/urandom \
    /dev/mem \
    /dev/rmem \
    /dev/ipu \
    /dev/tx-isp \
    /dev/isp-m0 \
    /dev/avpu \
    /dev/dsp \
    /dev/sinfo \
    /dev/speakerctl \
    /dev/jz_pwm_hal_0 \
    /dev/jz_pwm_hal_1 \
    /dev/framechan0 \
    /dev/framechan1 \
    /dev/framechan2 \
    /dev/framechan3; do
    bind_device "$device_source" || return 1
  done

  if [ -d /dev/snd ]; then
    mkdir -p "$vendor_root/dev/snd"
    mount_and_record "$vendor_root/dev/snd" \
      /bin/mount --bind /dev/snd "$vendor_root/dev/snd" || return 1
  fi

  mkdir -p "$vendor_root/dev/shm"
  chmod 1777 "$vendor_root/dev/shm"

  : >"$vendor_root/dev/mmcblk0p1"
  chmod 600 "$vendor_root/dev/mmcblk0p1"

  if [ -b "$vendor_root/dev/mmcblk0p1" ]; then
    echo "atomcam2-vendor-camera: private MMC placeholder became a block device" >&2
    return 1
  fi

  pass "private MMC compatibility path is a bounded regular file"

  for required_device in \
    "$vendor_root/dev/mem" \
    "$vendor_root/dev/rmem" \
    "$vendor_root/dev/tx-isp" \
    "$vendor_root/dev/avpu" \
    "$vendor_root/dev/speakerctl"; do
    if [ ! -e "$required_device" ]; then
      echo "atomcam2-vendor-camera: required camera device is missing: $required_device" >&2
      return 1
    fi
  done

  if [ -e "$vendor_root/dev/watchdog" ] ||
      [ -e "$vendor_root/dev/watchdog0" ]; then
    echo "atomcam2-vendor-camera: private device view exposes a watchdog" >&2
    return 1
  fi

  pass "private device view excludes the hardware watchdog"
}

setup_blocked_commands() {
  blocked_commands="
    devmem
    flash_erase
    fw_printenv
    fw_setenv
    halt
    insmod
    modprobe
    mount
    poweroff
    reboot
    rmmod
    umount
  "

  if [ ! -x "$blocked_command" ]; then
    echo "atomcam2-vendor-camera: blocked-command helper is unavailable" >&2
    return 1
  fi

  mkdir -p "$vendor_root/tmp/atomcam2-vendor-camera/bin"

  for command_name in $blocked_commands; do
    command_target="$vendor_root/tmp/atomcam2-vendor-camera/bin/$command_name"
    : >"$command_target"
    mount_and_record "$command_target" \
      /bin/mount --bind "$blocked_command" "$command_target" || return 1
  done
}

setup_nerves_owned_commands() {
  nerves_owned_commands="
    blkid
    ifconfig
    ip
    killall
    tf_prepare
    udhcpc
    wpa_cli
    wpa_supplicant
  "
  restart_wlan_target="$vendor_system/bin/restart_wlan0.sh"

  if [ ! -x "$nerves_owned_command" ]; then
    echo "atomcam2-vendor-camera: Nerves-owned command helper is unavailable" >&2
    return 1
  fi

  if [ ! -x "$restart_wlan_target" ]; then
    echo "atomcam2-vendor-camera: vendor Wi-Fi restart helper is unavailable" >&2
    return 1
  fi

  for command_name in $nerves_owned_commands; do
    command_target="$vendor_root/tmp/atomcam2-vendor-camera/bin/$command_name"
    : >"$command_target"
    mount_and_record "$command_target" \
      /bin/mount --bind "$nerves_owned_command" "$command_target" || return 1
  done

  mount_and_record "$restart_wlan_target" \
    /bin/mount --bind "$nerves_owned_command" "$restart_wlan_target"
}

setup_compatibility_mounts() {
  : >"$mounts_file"

  for transient_mount in \
    "$vendor_root/tmp" \
    "$vendor_root/run" \
    "$vendor_root/dev" \
    "$vendor_root/media" \
    "$vendor_root/sbin"; do
    if mount_present "$transient_mount"; then
      echo "atomcam2-vendor-camera: unexpected pre-existing mount at $transient_mount" >&2
      return 1
    fi
  done

  mount_and_record "$vendor_root/tmp" \
    /bin/mount -t tmpfs -o size=16m,mode=1777,nosuid,nodev \
    atomcam2-vendor-tmp "$vendor_root/tmp" || return 1
  mount_and_record "$vendor_root/run" \
    /bin/mount -t tmpfs -o size=1m,mode=0755,nosuid,nodev \
    atomcam2-vendor-run "$vendor_root/run" || return 1
  mount_and_record "$vendor_root/dev" \
    /bin/mount -t tmpfs -o size=1m,mode=0755,nosuid \
    atomcam2-vendor-dev "$vendor_root/dev" || return 1
  mount_and_record "$vendor_root/media" \
    /bin/mount -t tmpfs -o size=1m,mode=0755,nosuid,nodev \
    atomcam2-vendor-media "$vendor_root/media" || return 1
  mount_and_record "$vendor_root/sbin" \
    /bin/mount -t tmpfs -o size=1m,mode=0755,nosuid,nodev \
    atomcam2-vendor-sbin "$vendor_root/sbin" || return 1

  : >"$vendor_root/sbin/insmod"
  mount_and_record "$vendor_root/sbin/insmod" \
    /bin/mount --bind "$vendor_root/bin/busybox" \
    "$vendor_root/sbin/insmod" || return 1

  mount_and_record "$vendor_configs" \
    /bin/mount --bind "$private_configs" "$vendor_configs" || return 1

  mkdir -p "$vendor_root/media/mmc"
  mount_and_record "$vendor_root/media/mmc" \
    /bin/mount --bind "$spool_root" "$vendor_root/media/mmc" || return 1

  mount_and_record "$vendor_root/proc" \
    /bin/mount -t proc -o ro,nosuid,nodev,noexec \
    proc "$vendor_root/proc" || return 1
  mount_and_record "$vendor_root/sys" \
    /bin/mount -t sysfs -o ro,nosuid,nodev,noexec \
    sysfs "$vendor_root/sys" || return 1

  mkdir -p "$vendor_root/tmp/atomcam2-vendor-camera/lib"
  cp /etc/resolv.conf \
    "$vendor_root/tmp/atomcam2-vendor-camera/nerves-resolv.conf"
  chmod 400 "$vendor_root/tmp/atomcam2-vendor-camera/nerves-resolv.conf"
  nerves_wlan0_ipv4="$(
    /sbin/ip -4 -o addr show dev wlan0 |
      awk '{ sub(/\/.*/, "", $4); print $4; exit }'
  )"

  case "$nerves_wlan0_ipv4" in
    ""|*[!0-9.]*)
      echo "atomcam2-vendor-camera: wlan0 has no usable IPv4 address" >&2
      return 1
      ;;
  esac

  printf '%s\n' "$nerves_wlan0_ipv4" \
    >"$vendor_root/tmp/atomcam2-vendor-camera/wlan0-ipv4"
  chmod 400 "$vendor_root/tmp/atomcam2-vendor-camera/wlan0-ipv4"
  cp /etc/resolv.conf "$vendor_root/tmp/resolv.conf"
  chmod 644 "$vendor_root/tmp/resolv.conf"
  : >"$vendor_root/tmp/wpa.log"
  chmod 600 "$vendor_root/tmp/wpa.log"

  cp "$compat_shim" \
    "$vendor_root/tmp/atomcam2-vendor-camera/lib/libcompat-shim.so"
  chmod 0555 \
    "$vendor_root/tmp/atomcam2-vendor-camera/lib/libcompat-shim.so"

  setup_blocked_commands || return 1
  setup_nerves_owned_commands
}

start_prerequisites() {
  start_failures=0

  require_read_only_mount "$vendor_root" "" "squashfs"
  require_read_only_mount "$vendor_system" "/dev/mtdblock3" "squashfs"
  require_read_only_mount "$vendor_configs" "/dev/mtdblock6" "jffs2"
  require_read_write_mount "$data_mount"
  start_failures="$failures"

  if [ ! -r "$private_configs/.atomcam2-vendor-camera-schema" ]; then
    echo "atomcam2-vendor-camera: run prepare before start" >&2
    start_failures=$((start_failures + 1))
  fi

  if [ ! -x "$chroot_command" ]; then
    echo "atomcam2-vendor-camera: chroot support is unavailable" >&2
    start_failures=$((start_failures + 1))
  fi

  if [ ! -x "$blocked_command" ]; then
    echo "atomcam2-vendor-camera: blocked-command helper is unavailable" >&2
    start_failures=$((start_failures + 1))
  fi

  if [ ! -x "$nerves_owned_command" ]; then
    echo "atomcam2-vendor-camera: Nerves-owned command helper is unavailable" >&2
    start_failures=$((start_failures + 1))
  fi

  if [ ! -x "$setpriv_command" ]; then
    echo "atomcam2-vendor-camera: setpriv support is unavailable" >&2
    start_failures=$((start_failures + 1))
  fi

  if [ ! -r "$compat_shim" ]; then
    echo "atomcam2-vendor-camera: vendor compatibility shim is unavailable" >&2
    start_failures=$((start_failures + 1))
  fi

  case "$sensor_data_interface" in
    0|1|2)
      ;;
    *)
      echo "atomcam2-vendor-camera: sensor data interface must be 0, 1, or 2" >&2
      start_failures=$((start_failures + 1))
      ;;
  esac

  watchdog_owner="$(find_watchdog_owner)"

  case "$watchdog_owner" in
    *:heart:/dev/watchdog|*:heart:/dev/watchdog0)
      pass "Nerves heart owns the hardware watchdog before start"
      ;;
    *)
      echo "atomcam2-vendor-camera: Nerves heart does not own the hardware watchdog" >&2
      start_failures=$((start_failures + 1))
      ;;
  esac

  if ! grep -q '^atbm603x_wifi_sdio ' /proc/modules ||
      [ ! -d /sys/class/net/wlan0 ]; then
    echo "atomcam2-vendor-camera: Nerves Wi-Fi is unavailable" >&2
    start_failures=$((start_failures + 1))
  fi

  for expected_vendor_process in iCamera_app assis hl_client; do
    if process_running "$expected_vendor_process"; then
      echo "atomcam2-vendor-camera: process already running: $expected_vendor_process" >&2
      start_failures=$((start_failures + 1))
    fi
  done

  for expected_camera_module in \
    tx_isp_t31 \
    audio \
    avpu \
    sinfo \
    sensor_gc2053_t31 \
    sample_pwm_core \
    sample_pwm_hal \
    speaker_ctl; do
    if module_loaded "$expected_camera_module"; then
      echo "atomcam2-vendor-camera: camera module already loaded: $expected_camera_module" >&2
      start_failures=$((start_failures + 1))
    fi
  done

  if [ "$start_failures" -gt 0 ]; then
    return 1
  fi

  return 0
}

vendor_environment() {
  /usr/bin/env -i \
    PATH=/tmp/atomcam2-vendor-camera/bin:/system/bin:/bin:/sbin:/usr/bin:/usr/sbin \
    LD_LIBRARY_PATH=/thirdlib:/system/lib:/lib:/usr/lib \
    HOME=/root \
    TMPDIR=/tmp \
    ASSIS_LOG=/dev/null \
    "$setpriv_command" \
    --nnp \
    --bounding-set=-sys_admin,-sys_boot,-net_admin,-sys_module,-mknod \
    "$@"
}

exec_vendor_environment() {
  exec /usr/bin/env -i \
    PATH=/tmp/atomcam2-vendor-camera/bin:/system/bin:/bin:/sbin:/usr/bin:/usr/sbin \
    LD_LIBRARY_PATH=/thirdlib:/system/lib:/lib:/usr/lib \
    LD_PRELOAD=/tmp/atomcam2-vendor-camera/lib/libcompat-shim.so \
    HOME=/root \
    TMPDIR=/tmp \
    ASSIS_LOG=/dev/null \
    "$setpriv_command" \
    --nnp \
    --bounding-set=-sys_admin,-sys_boot,-net_admin,-sys_module,-mknod \
    "$@"
}

exec_vendor_assis_environment() {
  exec /usr/bin/env -i \
    PATH=/tmp/atomcam2-vendor-camera/bin:/system/bin:/bin:/sbin:/usr/bin:/usr/sbin \
    LD_LIBRARY_PATH=/thirdlib:/system/lib:/lib:/usr/lib \
    LD_PRELOAD=/tmp/atomcam2-vendor-camera/lib/libcompat-shim.so \
    HOME=/root \
    TMPDIR=/tmp \
    ASSIS_LOG=/dev/null \
    "$setpriv_command" \
    --nnp \
    --bounding-set=-sys_admin,-sys_boot,-net_admin,-sys_module,-mknod,-sys_rawio \
    "$@"
}

start_vendor_processes() {
  : >"$logs_root/ver-comp.log"
  : >"$logs_root/assis.log"
  : >"$logs_root/hl_client.log"
  : >"$logs_root/iCamera_app.log"
  chmod 600 "$logs_root"/*.log

  if ! vendor_environment \
      "$chroot_command" "$vendor_root" /system/bin/ver-comp \
      >>"$logs_root/ver-comp.log" 2>&1; then
    echo "atomcam2-vendor-camera: ver-comp failed" >&2
    return 1
  fi

  exec_vendor_assis_environment \
    "$chroot_command" "$vendor_root" /system/bin/assis \
    </dev/null >>"$logs_root/assis.log" 2>&1 &
  assis_pid="$!"
  printf '%s\n' "$assis_pid" >"$state_root/assis.pid"

  sleep 2

  if ! track_started_process assis "$state_root/assis.pid"; then
    echo "atomcam2-vendor-camera: assis exited during startup" >&2
    return 1
  fi

  exec_vendor_environment \
    "$chroot_command" "$vendor_root" /system/bin/hl_client \
    </dev/null >>"$logs_root/hl_client.log" 2>&1 &
  hl_client_pid="$!"
  printf '%s\n' "$hl_client_pid" >"$state_root/hl_client.pid"

  sleep 1

  exec_vendor_environment \
    "$chroot_command" "$vendor_root" /system/bin/iCamera_app \
    </dev/null >>"$logs_root/iCamera_app.log" 2>&1 &
  icamera_pid="$!"
  printf '%s\n' "$icamera_pid" >"$state_root/iCamera_app.pid"

  sleep 5

  if ! track_started_process hl_client "$state_root/hl_client.pid"; then
    echo "atomcam2-vendor-camera: hl_client exited during startup" >&2
    return 1
  fi

  if ! track_started_process iCamera_app "$state_root/iCamera_app.pid"; then
    echo "atomcam2-vendor-camera: iCamera_app exited during startup" >&2
    return 1
  fi

  if ! track_started_process assis "$state_root/assis.pid"; then
    echo "atomcam2-vendor-camera: assis exited during camera startup" >&2
    return 1
  fi

  assis_pid="$(cat "$state_root/assis.pid")"

  if ! grep -q '/tmp/atomcam2-vendor-camera/lib/libcompat-shim.so' \
      "/proc/$assis_pid/maps"; then
    echo "atomcam2-vendor-camera: assis watchdog shim is not active" >&2
    return 1
  fi

  icamera_pid="$(cat "$state_root/iCamera_app.pid")"

  if ! grep -q '/tmp/atomcam2-vendor-camera/lib/libcompat-shim.so' \
      "/proc/$icamera_pid/maps"; then
    echo "atomcam2-vendor-camera: iCamera storage shim is not active" >&2
    return 1
  fi

  watchdog_owner="$(find_watchdog_owner)"

  case "$watchdog_owner" in
    *:heart:/dev/watchdog|*:heart:/dev/watchdog0)
      pass "Nerves heart still owns the hardware watchdog"
      ;;
    *)
      echo "atomcam2-vendor-camera: watchdog ownership changed during startup" >&2
      return 1
      ;;
  esac

  pass "manual vendor camera processes are running with isolated assis"
}

start_runtime() {
  require_root || return 1
  acquire_lock || return 1
  umask 077

  clear_stale_runtime_state

  if [ "$(read_runtime_state)" = "running" ]; then
    echo "atomcam2-vendor-camera: runtime state already says running" >&2
    return 1
  fi

  start_prerequisites || return 1

  mkdir -p "$state_root" "$logs_root" "$spool_root"
  chmod 700 "$state_root" "$logs_root" "$spool_root"
  current_boot_id >"$boot_id_file"
  : >"$modules_file"
  write_runtime_state "starting"

  snapshot_ipc msg
  snapshot_ipc shm
  snapshot_ipc sem

  if ! setup_compatibility_mounts; then
    echo "atomcam2-vendor-camera: compatibility mount setup failed" >&2
    stop_runtime
    return 1
  fi

  if ! load_camera_module \
      tx_isp_t31 "$vendor_system/driver/tx-isp-t31.ko" isp_clk=100000000 ||
      ! load_camera_module \
        audio "$vendor_system/driver/audio.ko" spk_gpio=-1 ||
      ! load_camera_module \
        avpu "$vendor_system/driver/avpu.ko" ||
      ! load_camera_module \
        sinfo "$vendor_system/driver/sinfo.ko" ||
      ! load_camera_module \
        sensor_gc2053_t31 \
        "$vendor_system/driver/sensor_gc2053_t31.ko" \
        "data_interface=$sensor_data_interface" ||
      ! load_camera_module \
        sample_pwm_core "$vendor_system/driver/sample_pwm_core.ko" ||
      ! load_camera_module \
        sample_pwm_hal "$vendor_system/driver/sample_pwm_hal.ko" ||
      ! load_camera_module \
        speaker_ctl "$vendor_system/driver/speaker_ctl.ko"; then
    echo "atomcam2-vendor-camera: camera module setup failed" >&2
    stop_runtime
    return 1
  fi

  if ! setup_device_view; then
    echo "atomcam2-vendor-camera: private device setup failed" >&2
    stop_runtime
    return 1
  fi

  if ! start_vendor_processes; then
    echo "atomcam2-vendor-camera: vendor process startup failed" >&2
    stop_runtime
    return 1
  fi

  write_runtime_state "running"
  pass "manual vendor camera runtime started"
  info "logs=$logs_root"
}

tracked_process_pid() {
  process_pid_file="$1"
  expected_process_name="$2"
  tracked_pid="$(cat "$process_pid_file" 2>/dev/null || true)"

  if [ -z "$tracked_pid" ] ||
      [ ! -r "/proc/$tracked_pid/comm" ]; then
    return 1
  fi

  tracked_name="$(cat "/proc/$tracked_pid/comm" 2>/dev/null || true)"
  [ "$tracked_name" = "$expected_process_name" ]
}

find_process_pid() {
  expected_process_name="$1"

  for process_status in /proc/[0-9]*/status; do
    candidate_process_name="$(
      awk '$1 == "Name:" { print $2; exit }' "$process_status" 2>/dev/null
    )"

    if [ "$candidate_process_name" = "$expected_process_name" ]; then
      candidate_pid="${process_status#/proc/}"
      echo "${candidate_pid%%/*}"
      return 0
    fi
  done

  return 1
}

track_started_process() {
  expected_process_name="$1"
  process_pid_file="$2"

  if tracked_process_pid "$process_pid_file" "$expected_process_name"; then
    return 0
  fi

  discovered_pid="$(find_process_pid "$expected_process_name" || true)"

  if [ -z "$discovered_pid" ]; then
    return 1
  fi

  printf '%s\n' "$discovered_pid" >"$process_pid_file"
  tracked_process_pid "$process_pid_file" "$expected_process_name"
}

signal_tracked_process() {
  process_pid_file="$1"
  expected_process_name="$2"
  signal_name="$3"

  if tracked_process_pid "$process_pid_file" "$expected_process_name"; then
    /bin/kill "-$signal_name" "$tracked_pid" 2>/dev/null || true
  fi
}

private_runtime_pids() {
  for process_root in /proc/[0-9]*/root; do
    private_root="$(readlink "$process_root" 2>/dev/null || true)"

    case "$private_root" in
      "$vendor_root"|"$vendor_root"/*)
        private_pid="${process_root#/proc/}"
        echo "${private_pid%%/*}"
        ;;
    esac
  done
}

private_runtime_processes_running() {
  [ -n "$(private_runtime_pids)" ]
}

signal_private_runtime_processes() {
  signal_name="$1"

  private_runtime_pids |
    while IFS= read -r private_pid; do
      [ -n "$private_pid" ] || continue
      /bin/kill "-$signal_name" "$private_pid" 2>/dev/null || true
    done
}

cleanup_new_ipc() {
  ipc_kind="$1"
  ipcrm_flag="$2"
  ipc_source="/proc/sysvipc/$ipc_kind"
  ipc_before="$ipc_before_prefix.$ipc_kind"

  [ -r "$ipc_source" ] || return 0
  [ -x /usr/bin/ipcrm ] || return 0

  awk 'NR > 1 { print $2 }' "$ipc_source" |
    while IFS= read -r ipc_id; do
      if ! grep -qx "$ipc_id" "$ipc_before" 2>/dev/null; then
        /usr/bin/ipcrm "$ipcrm_flag" "$ipc_id" 2>/dev/null || true
      fi
    done
}

cleanup_mounts() {
  [ -r "$mounts_file" ] || return 0

  reversed_mounts="$state_root/mounts.reverse.$$"
  awk '{ lines[NR] = $0 }
       END {
         for (line = NR; line > 0; line--) {
           print lines[line]
         }
       }' "$mounts_file" >"$reversed_mounts"

  while IFS= read -r mounted_target; do
    [ -n "$mounted_target" ] || continue

    if mount_present "$mounted_target" &&
        ! /bin/umount "$mounted_target"; then
      echo "atomcam2-vendor-camera: could not unmount $mounted_target" >&2
      cleanup_failures=$((cleanup_failures + 1))
    fi
  done <"$reversed_mounts"

  rm -f "$reversed_mounts"
}

clear_process_state() {
  rm -f \
    "$state_root/assis.pid" \
    "$state_root/hl_client.pid" \
    "$state_root/iCamera_app.pid" \
    "$ipc_before_prefix.msg" \
    "$ipc_before_prefix.shm" \
    "$ipc_before_prefix.sem"
}

clear_transient_state() {
  clear_process_state
  rm -f "$mounts_file" "$modules_file" "$boot_id_file"
}

stop_runtime() {
  write_runtime_state "stopping"

  started_boot_id="$(cat "$boot_id_file" 2>/dev/null || true)"
  running_boot_id="$(current_boot_id)"

  if [ -n "$started_boot_id" ] &&
      [ "$started_boot_id" != "$running_boot_id" ]; then
    clear_transient_state
    write_runtime_state "prepared"
    pass "cleared stale runtime state from an earlier boot"
    return 0
  fi

  signal_tracked_process "$state_root/assis.pid" assis TERM
  signal_tracked_process "$state_root/iCamera_app.pid" iCamera_app TERM
  signal_tracked_process "$state_root/hl_client.pid" hl_client TERM
  signal_private_runtime_processes TERM

  wait_count=0
  while [ "$wait_count" -lt 5 ]; do
    if ! tracked_process_pid "$state_root/assis.pid" assis &&
        ! tracked_process_pid "$state_root/iCamera_app.pid" iCamera_app &&
        ! tracked_process_pid "$state_root/hl_client.pid" hl_client &&
        ! private_runtime_processes_running; then
      break
    fi

    sleep 1
    wait_count=$((wait_count + 1))
  done

  signal_tracked_process "$state_root/assis.pid" assis KILL
  signal_tracked_process "$state_root/iCamera_app.pid" iCamera_app KILL
  signal_tracked_process "$state_root/hl_client.pid" hl_client KILL
  signal_private_runtime_processes KILL
  sleep 1

  cleanup_new_ipc msg -q
  cleanup_new_ipc shm -m
  cleanup_new_ipc sem -s
  cleanup_mounts
  clear_process_state

  if [ "$cleanup_failures" -gt 0 ]; then
    write_runtime_state "cleanup-failed"
    return 1
  fi

  rm -f "$mounts_file"

  if [ -s "$modules_file" ]; then
    write_runtime_state "stopped-reboot-required"
    pass "manual vendor processes, mounts, and IPC are stopped and cleaned up"
    info "camera modules remain loaded until the next reboot"
  else
    rm -f "$boot_id_file"
    write_runtime_state "prepared"
    pass "manual vendor camera runtime stopped and cleaned up"
  fi
}

stop_command() {
  require_root || return 1
  acquire_lock || return 1
  stop_runtime
}

process_status_line() {
  expected_process_name="$1"
  process_pid_file="$2"

  if tracked_process_pid "$process_pid_file" "$expected_process_name"; then
    process_rss_kb="$(
      awk '$1 == "VmRSS:" { print $2; exit }' \
        "/proc/$tracked_pid/status" 2>/dev/null
    )"
    echo "process=$expected_process_name pid=$tracked_pid rss_kb=${process_rss_kb:-unknown} state=running"
    return 0
  fi

  echo "process=$expected_process_name state=stopped"
  return 1
}

status_runtime() {
  status_failures=0
  recorded_state="$(read_runtime_state)"
  recorded_boot_id="$(cat "$boot_id_file" 2>/dev/null || true)"

  case "$recorded_state" in
    running|starting|stopping|stopped-reboot-required|cleanup-failed)
      if [ -n "$recorded_boot_id" ] &&
          [ "$recorded_boot_id" != "$(current_boot_id)" ]; then
        recorded_state="prepared"
      fi
      ;;
    *)
      ;;
  esac

  echo "state=$recorded_state"

  if process_status_line iCamera_app "$state_root/iCamera_app.pid"; then
    if grep -q '/tmp/atomcam2-vendor-camera/lib/libcompat-shim.so' \
        "/proc/$tracked_pid/maps"; then
      echo "storage_isolation=shim_active"
    else
      echo "storage_isolation=shim_missing"
      status_failures=$((status_failures + 1))
    fi
  elif [ "$recorded_state" = "running" ]; then
    status_failures=$((status_failures + 1))
  else
    echo "storage_isolation=inactive"
  fi

  if process_status_line hl_client "$state_root/hl_client.pid"; then
    :
  elif [ "$recorded_state" = "running" ]; then
    status_failures=$((status_failures + 1))
  fi

  if process_status_line assis "$state_root/assis.pid"; then
    if grep -q '/tmp/atomcam2-vendor-camera/lib/libcompat-shim.so' \
        "/proc/$tracked_pid/maps"; then
      echo "watchdog_isolation=shim_active"
    else
      echo "watchdog_isolation=shim_missing"
      status_failures=$((status_failures + 1))
    fi
  elif [ "$recorded_state" = "running" ]; then
    status_failures=$((status_failures + 1))
  else
    echo "watchdog_isolation=inactive"
  fi

  watchdog_owner="$(find_watchdog_owner)"
  echo "watchdog_owner=${watchdog_owner:-none}"

  case "$watchdog_owner" in
    *:heart:/dev/watchdog|*:heart:/dev/watchdog0)
      ;;
    *)
      status_failures=$((status_failures + 1))
      ;;
  esac

  if [ "$recorded_state" = "running" ]; then
    if [ -e "$vendor_root/dev/watchdog" ] ||
        [ -e "$vendor_root/dev/watchdog0" ]; then
      echo "private_watchdog_view=exposed"
      status_failures=$((status_failures + 1))
    else
      echo "private_watchdog_view=absent"
    fi
  fi

  reclaimable_kb="$(
    awk '
      $1 == "MemFree:" || $1 == "Buffers:" || $1 == "Cached:" {
        total += $2
      }
      END {
        print total + 0
      }
    ' /proc/meminfo
  )"
  echo "memory_reclaimable_kb=$reclaimable_kb"
  echo "logs=$logs_root"

  if [ "$status_failures" -gt 0 ]; then
    echo "result=degraded"
    return 1
  fi

  if [ "$recorded_state" = "running" ]; then
    echo "result=running"
  elif [ "$recorded_state" = "stopped-reboot-required" ]; then
    echo "result=stopped_reboot_required"
  else
    echo "result=stopped"
  fi
}

case "${1:-}" in
  precheck)
    precheck
    ;;
  prepare)
    prepare_runtime
    ;;
  start)
    start_runtime
    ;;
  status)
    status_runtime
    ;;
  stop)
    stop_command
    ;;
  -h|--help|"")
    usage
    ;;
  *)
    usage >&2
    exit 64
    ;;
esac
