#!/bin/sh
set -eu

if [ -f /etc/atomcam2.env ]; then
  . /etc/atomcam2.env
fi

if [ -f /media/mmc/atomcam2.env ]; then
  . /media/mmc/atomcam2.env
fi

boot_mount="${ATOMCAM2_BOOT_MOUNT:-/media/mmc}"
report_file="${ATOMCAM2_PRE_RUN_REPORT:-/media/mmc/atomcam2-pre-run.env}"
default_hostname="${ATOMCAM2_DEFAULT_HOSTNAME:-nerves}"
hostname_file="${ATOMCAM2_HOSTNAME_FILE:-/media/mmc/hostname}"
data_mount="${ATOMCAM2_DATA_MOUNT:-/data}"
data_init_marker="${ATOMCAM2_DATA_INIT_MARKER:-$boot_mount/atomcam2-data-init}"

find_boot_partition() {
  awk -v boot_mount="$boot_mount" '
    $2 == boot_mount {
      print $1
      exit
    }
  ' /proc/mounts
}

create_rootdisk_links() {
  boot_partition="$(find_boot_partition)"

  case "$boot_partition" in
    /dev/mmcblk[0-9]p[0-9]*)
      root_disk="${boot_partition%p[0-9]*}"
      ;;
    /dev/mmcblk[0-9])
      root_disk="$boot_partition"
      ;;
    *)
      return 1
      ;;
  esac

  application_slot_a_partition="${root_disk}p2"
  application_slot_b_partition="${root_disk}p3"
  application_partition="$application_slot_a_partition"
  data_partition="${root_disk}p4"

  if [ ! -b "$root_disk" ]; then
    return 1
  fi

  if ! ln -sf "$root_disk" /dev/rootdisk0; then
    return 1
  fi

  case "$boot_partition" in
    /dev/mmcblk[0-9]p[0-9]*)
      if ! ln -sf "$boot_partition" /dev/rootdisk0p1; then
        return 1
      fi
      ;;
    *)
      if ! rm -f /dev/rootdisk0p1; then
        return 1
      fi
      ;;
  esac

  if [ -b "$application_slot_a_partition" ]; then
    if ! ln -sf "$application_slot_a_partition" /dev/rootdisk0p2; then
      return 1
    fi
  else
    if ! rm -f /dev/rootdisk0p2; then
      return 1
    fi
  fi

  if [ -b "$application_slot_b_partition" ]; then
    if ! ln -sf "$application_slot_b_partition" /dev/rootdisk0p3; then
      return 1
    fi
  else
    if ! rm -f /dev/rootdisk0p3; then
      return 1
    fi
  fi

  if [ -b "$data_partition" ]; then
    if ! ln -sf "$data_partition" /dev/rootdisk0p4; then
      return 1
    fi
  else
    if ! rm -f /dev/rootdisk0p4; then
      return 1
    fi
  fi

  return 0
}

valid_hostname() {
  case "$1" in
    ""|.*|-*|*-|*..*|*.-*|*-.*|*[!A-Za-z0-9.-]*) return 1 ;;
    *) return 0 ;;
  esac
}

read_hostname() {
  if [ -f "$hostname_file" ]; then
    sed -n '1{s/\r$//;p;}' "$hostname_file"
  else
    printf '%s\n' "$default_hostname"
  fi
}

data_initialization_requested() {
  if [ ! -f "$data_init_marker" ]; then
    return 1
  fi

  data_init_marker_value="$(
    sed -n '1{s/\r$//;p;}' "$data_init_marker"
  )"

  if [ "$data_init_marker_value" = "format-if-missing" ]; then
    return 0
  else
    return 1
  fi
}

data_partition_has_ext2() {
  if /sbin/dumpe2fs -h "$data_partition" >/dev/null 2>&1; then
    return 0
  else
    return 1
  fi
}

prepare_data_partition() {
  if [ ! -b "$data_partition" ]; then
    data_status="partition_missing"
    return 1
  fi

  if [ ! -x /sbin/dumpe2fs ]; then
    data_status="dumpe2fs_missing"
    return 1
  fi

  if [ ! -x /sbin/mkfs.ext2 ]; then
    data_status="mkfs_ext2_missing"
    return 1
  fi

  if [ ! -x /bin/mount ]; then
    data_status="mount_missing"
    return 1
  fi

  if data_initialization_requested; then
    data_init_requested=1
  fi

  if data_partition_has_ext2; then
    data_status="existing_ext2"
  elif [ "$data_init_requested" = "1" ]; then
    if /sbin/mkfs.ext2 \
      -q \
      -F \
      -m 0 \
      -L ATOMCAM2_DATA \
      "$data_partition"; then

      data_status="formatted_ext2"
    else
      data_status="format_failed"
      return 1
    fi
  else
    data_status="filesystem_missing"
    return 1
  fi

  if grep -F " $data_mount " /proc/mounts >/dev/null; then
    data_status="${data_status}_mounted"
  elif /bin/mount \
    -t ext2 \
    "$data_partition" \
    "$data_mount"; then

    data_status="${data_status}_mounted"
  else
    data_status="mount_failed"
    return 1
  fi

  data_probe_file="$data_mount/.atomcam2-write-probe"

  if : > "$data_probe_file"; then
    data_writable=1
  else
    data_status="write_probe_failed"
    return 1
  fi

  if rm -f "$data_probe_file"; then
    :
  else
    data_status="write_probe_remove_failed"
    return 1
  fi

  if [ "$data_init_requested" = "1" ]; then
    if rm -f "$data_init_marker"; then
      data_init_requested=0
    else
      data_status="init_marker_remove_failed"
      return 1
    fi
  fi

  return 0
}

write_report() {
  report_stage="$1"

  if {
    echo "stage=$report_stage"
    echo "rootdisk_links=$rootdisk_links"
    echo "root_disk=$root_disk"
    echo "boot_partition=$boot_partition"
    echo "application_partition=$application_partition"
    echo "application_slot_a_partition=$application_slot_a_partition"
    echo "application_slot_b_partition=$application_slot_b_partition"
    echo "data_partition=$data_partition"
    echo "data_mount=$data_mount"
    echo "data_status=$data_status"
    echo "data_writable=$data_writable"
    echo "data_init_requested=$data_init_requested"
    echo "hostname=$(hostname 2>/dev/null || true)"
    echo "wlan0_present=$(ifconfig wlan0 >/dev/null 2>&1 && echo 1 || echo 0)"
    echo "eth0_present=$(ifconfig eth0 >/dev/null 2>&1 && echo 1 || echo 0)"
  } > "$report_file" 2>/dev/null; then
    :
  else
    echo "atomcam2 pre-run: could not write $report_file" >&2
  fi
}

if mkdir -p "$boot_mount" "$data_mount" /tmp; then
  :
else
  echo "atomcam2 pre-run: could not prepare mount directories" >&2
  exit 1
fi

# Turn both status LEDs off as early in boot as possible so nothing shows
# until the application's StatusLed starts the yellow boot blink. Both
# LEDs (yellow GPIO 38, blue GPIO 39) are wired active-low, so "off"
# means driving the pins high.
led_off() {
  led_gpio="$1"
  led_off_value="$2"

  if [ ! -d "/sys/class/gpio/gpio$led_gpio" ]; then
    echo "$led_gpio" > /sys/class/gpio/export 2>/dev/null || return 0
  fi

  echo out > "/sys/class/gpio/gpio$led_gpio/direction" 2>/dev/null || return 0
  echo "$led_off_value" > "/sys/class/gpio/gpio$led_gpio/value" 2>/dev/null || true
}

led_off 38 1
led_off 39 1

root_disk=""
boot_partition=""
application_partition=""
application_slot_a_partition=""
application_slot_b_partition=""
data_partition=""
rootdisk_links=0
data_status="not_started"
data_writable=0
data_init_requested=0

if create_rootdisk_links; then
  rootdisk_links=1
fi

desired_hostname="$(read_hostname)"
if ! valid_hostname "$desired_hostname"; then
  desired_hostname="$default_hostname"
fi

if ! valid_hostname "$desired_hostname"; then
  desired_hostname="nerves"
fi

hostname "$desired_hostname" 2>/dev/null || true

if prepare_data_partition; then
  :
else
  write_report "pre_run_failed"
  echo "atomcam2 pre-run: $data_status" >&2
  exit 1
fi

if [ "${ATOMCAM2_PRE_RUN_ETH_DRIVER:-1}" = "1" ]; then
  atomcam2-eth-driver || true
fi

if [ "${ATOMCAM2_PRE_RUN_VIDEO_LOOPBACK:-1}" = "1" ]; then
  atomcam2-video-loopback || true
fi

if [ "${ATOMCAM2_PRE_RUN_WIFI_DRIVER:-1}" = "1" ]; then
  atomcam2-wifi-driver || true
fi

# Load the ISP and audio modules while memory is still pristine. Loaded
# later in boot, audio.ko's DMA setup fails intermittently (about half of
# boots): the codec probe succeeds but /dev/dsp is never registered and
# IMP_AO_Enable returns -1 for the rest of the boot. tx_isp must load
# before audio (the codec comes up broken otherwise); speaker_ctl is the
# amp control. /atom is mounted by atomcam2-wifi-driver above.
if [ "${ATOMCAM2_PRE_RUN_AUDIO_MODULES:-1}" = "1" ] &&
    [ -f /atom/system/driver/audio.ko ]; then
  if ! grep -q "^tx_isp_t31 " /proc/modules 2>/dev/null; then
    insmod /atom/system/driver/tx-isp-t31.ko isp_clk=100000000 || true
  fi

  if [ ! -c /dev/dsp ]; then
    insmod /atom/system/driver/audio.ko spk_gpio=-1 || true
  fi

  if [ ! -c /dev/speakerctl ]; then
    insmod /atom/system/driver/speaker_ctl.ko || true
  fi
fi

atomcam2-network-check >/dev/null 2>&1 || true

write_report "pre_run_complete"

exit 0
