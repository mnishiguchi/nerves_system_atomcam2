#!/bin/sh
set -u

dns_source="/tmp/atomcam2-vendor-camera/nerves-resolv.conf"
dns_target="/tmp/resolv.conf"
ipv4_source="/tmp/atomcam2-vendor-camera/wlan0-ipv4"
command_name="${0##*/}"

if [ ! -r "$dns_source" ] ||
    ! /bin/cp "$dns_source" "$dns_target" ||
    ! /bin/chmod 644 "$dns_target"; then
  echo "atomcam2-vendor-camera: could not restore Nerves DNS" >&2
  exit 1
fi

case "$command_name" in
  blkid)
    printf '%s\n' '/dev/mmcblk0p1: TYPE="vfat"'
    ;;
  wpa_cli)
    if [ ! -r "$ipv4_source" ]; then
      echo "atomcam2-vendor-camera: Nerves wlan0 IPv4 address is unavailable" >&2
      exit 1
    fi

    printf '%s\n' "wpa_state=COMPLETED"
    printf 'ip_address=%s\n' "$(/bin/cat "$ipv4_source")"
    ;;
esac

echo "atomcam2-vendor-camera: emulated protected Nerves-owned command: $command_name" >&2
exit 0
