# Minimal starter kernel config fragment for AtomCam2 first-SSH bring-up.
# Replace this with the proven AtomCam2 / atomcam_tools kernel config before real hardware use.

CONFIG_MIPS=y
CONFIG_CPU_MIPS32_R5=y
CONFIG_CPU_LITTLE_ENDIAN=y
CONFIG_HZ_100=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y
